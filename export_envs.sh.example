# 개발 머신에서 서버를 로컬로 가동할 때에는 아래를 Redis 컨테이너에서 외부로 포워딩된 포트(56379)로 지정. 개발환경에서는 내부 포트(6379)를 그대로 지정.
export AFTERHEE_REDIS_PORT="6379"
